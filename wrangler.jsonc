{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ai-tester",
  "compatibility_date": "2026-10-29",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "main": ".open-next/worker.js",
  "assets": {
    "binding": "ASSETS",
    "directory": ".open-next/assets",
    "run_worker_first": true
  },
  "observability": {
    "enabled": true
  },
  "vars": {
    // Pagu token harian kunci shared per user msk_. Angka token/hari;
    // "0" = tanpa pagu (tidak disarankan). Edit nilai di sini — deploy
    // berikutnya otomatis memakai nilai baru.
    "SHARED_DAILY_TOKEN_BUDGET_PER_USER": "1000000"
  },
  "routes": [
    {
      "pattern": "gateway.msaku.id",
      "custom_domain": true
    }
  ]
}
