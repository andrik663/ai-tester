# ============================================================================
# ENVIRONMENT VARIABLES FOR AI TESTER
# ============================================================================
#
# Copy this file to .env.local (development) or set these in your hosting
# platform (Vercel, Docker, etc.)
#
# Required: AI_GATEWAY_API_KEY
# Optional: Others for advanced features

# ============================================================================
# REQUIRED VARIABLES
# ============================================================================

# Vercel AI Gateway API Key - enables the auto-detect provider feature
# Get from: https://console.vercel.com/account/api-keys (create new)
# Format: vck_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
AI_GATEWAY_API_KEY=vck_your_api_key_here

# ============================================================================
# OPTIONAL VARIABLES (For deployment & monitoring)
# ============================================================================

# Vercel Analytics - track user behavior and errors
# Get from: https://vercel.com/docs/web-analytics
VERCEL_WEB_ANALYTICS_ID=your_analytics_id

# Vercel Environment
# Auto-set by Vercel, but useful for custom deployments
VERCEL_ENV=production

# ============================================================================
# FUTURE INTEGRATION OPTIONS (Not yet implemented)
# ============================================================================

# For future database integration
# DATABASE_URL=postgresql://user:password@localhost:5432/ai_tester

# For future webhook system
# WEBHOOK_SECRET=your_webhook_secret_key

# For future authentication
# AUTH_SECRET=your_auth_secret_key

# Rate limiting settings
# MAX_TESTS_PER_HOUR=1000
# MAX_BATCH_SIZE=100
# QUEUE_TIMEOUT_MS=30000

# Logging level: 'debug' | 'info' | 'warn' | 'error'
# LOG_LEVEL=info

# Feature flags for new features
# FEATURE_WEBHOOK_SYSTEM=false
# FEATURE_KEY_STORAGE=false
# FEATURE_ANALYTICS=true
